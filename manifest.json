{
  "manifestVersion": 5,
  "id": "com.hazem.imagedropper",
  "name": "ImageDropper",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [{
    "type": "panel",
    "id": "imageDropperPanel",
    "label": { "default": "ImageDropper" },
    "minimumSize": { "width": 280, "height": 310 },
    "preferredDockedSize": { "width": 350, "height": 440 }
  }],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "request"
  }
}
